{
    "name": "justinholtweb/craft-seclude",
    "description": "Per-element user restrictions for Craft CMS — restrict an editor to individual entries, categories, assets and users instead of whole sections, by hand-picked assignment or by rules that follow authorship, structure branches, relations and element conditions.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "permissions",
        "access-control",
        "entry-permissions",
        "user-restrictions",
        "multi-tenant",
        "editorial-workflow",
        "isolate"
    ],
    "homepage": "https://justinholt.com/plugins/craft-seclude",
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-seclude/docs",
        "source": "https://github.com/justinholtweb/craft-seclude",
        "issues": "https://github.com/justinholtweb/craft-seclude/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\seclude\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\seclude\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Seclude",
        "handle": "seclude",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-seclude/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-seclude/main/CHANGELOG.md",
        "class": "justinholtweb\\seclude\\Plugin"
    }
}
